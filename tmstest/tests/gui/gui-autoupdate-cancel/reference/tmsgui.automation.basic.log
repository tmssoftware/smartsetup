Starting Automation
wait: condition self.Name = MainForm
wait: condition Self.IsGuiRunning = false
set-text: "MainForm.edSearch" to "tms.fmx.icl"
wait: condition Self.ProductCount = 1
wait: condition Self.IsGuiRunning = false
call: "MainForm.lvproducts.SelectAll"
wait: condition btnInstall.Enabled 
click: "MainForm.btnInstall"
wait: condition self.Name = DialogForm
assert: "MemoMessage.Text ~ A new version of TMS Smart Setup is available and ready" is true
click: "DialogForm.btnCancel"
wait: condition self.Name = MainForm
wait: condition Self.IsGuiRunning = false
set: "MainForm.lbLog.ItemIndex" to "0"
wait: 500 milliseconds
click: "MainForm.acLogDetails"
wait: condition Self.Name = LogDetailsForm
click: "LogDetailsForm.btOk"
wait: condition Self.Name = MainForm
wait: condition Self.IsGuiRunning = false
set-text: "MainForm.edSearch" to "tms.biz.bcl"
wait: condition Self.ProductCount = 1
wait: condition Self.IsGuiRunning = false
call: "MainForm.lvproducts.SelectAll"
wait: condition btnInstall.Enabled 
click: "MainForm.btnInstall"
wait: condition Self.IsGuiRunning = false
assert: "self.Name = MainForm" is true
Completed successfully
