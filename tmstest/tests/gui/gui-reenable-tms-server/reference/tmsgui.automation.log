click: "DialogForm.btnOk"
wait: condition self.Name = MainForm
wait: condition Self.IsGuiRunning = false
set-text: "MainForm.edSearch" to "tms.biz.xdata"
assert: "Self.ProductCount = 0" is true
click: "MainForm.acCredentials"
wait: condition self.Name = CredentialsForm
set-text: "CredentialsForm.edEmail" to "****"
set-text: "CredentialsForm.edCode" to "****"
click: "CredentialsForm.btOk"
wait: condition Self.Name = MainForm
wait: condition Self.IsGuiRunning = false
set-text: "MainForm.edSearch" to "tms.biz.xdata"
assert: "Self.ProductCount > 0" is true
