Starting Automation
wait: condition self.Name = MainForm
wait: condition Self.IsGuiRunning = false
call: "MainForm.self.ChangeWorkingFolder" with "not-initialized-folder"
wait: condition self.Name = StartForm
click: "StartForm.btOk"
wait: condition self.Name = MainForm
assert: "self.GetWorkingFolder ~ gui-change-working-folder\not-initialized-folder" is true
wait: condition Self.ProductCount <> 0
set-text: "MainForm.edSearch" to "tms.graphql"
wait: 1000 milliseconds
wait: condition Self.IsGuiRunning = false
call: "MainForm.lvproducts.SelectAll"
wait: condition Self.ProductCount = 1
wait: condition btnInstall.Enabled 
click: "MainForm.btnInstall"
wait: condition OutputMemo.Text ~ Install finished. Elapsed time
wait: 1000 milliseconds
