unit Snapshot.Writer;

interface
uses Classes, SysUtils, Status.Manager, Generics.Collections, IOUtils;

procedure WriteSnapshot(const FileName: string; const Products: TList<TProductStatus>); overload;
procedure WriteSnapshot(const Writer: TStreamWriter; const Products: TList<TProductStatus>); overload;
function GetSnapshot(const Products: TList<TProductStatus>): TBytes;

implementation
uses UTmsBuildSystemUtils, BBStrings;

procedure WriteSnapshot(const FileName: string; const Products: TList<TProductStatus>);
begin
  var SnapshotFolder := TPath.GetDirectoryName(FileName);
  if SnapshotFolder.Trim <> '' then
  begin
    if not TDirectory.Exists(SnapshotFolder)
      then TDirectory_CreateDirectory(SnapshotFolder);
  end;

  var Writer := TStreamWriter.Create(FileName, false, TUTF8NoBOMEncoding.Instance);
  try
    WriteSnapshot(Writer, Products);
  finally
    Writer.Free;
  end;
end;

function GetSnapshot(const Products: TList<TProductStatus>): TBytes;
begin
  var SnapshotStream := TMemoryStream.Create;
  try
    var SnapshotWriter := TStreamWriter.Create(SnapshotStream, TUTF8NoBOMEncoding.Instance);
    try
      WriteSnapshot(SnapshotWriter, Products);
    finally
      SnapshotWriter.Free;
    end;
    SnapshotStream.Position := 0;
    Result := nil;
    SetLength(Result, SnapshotStream.Size);
    if Length(Result) > 0 then SnapshotStream.ReadBuffer(Result[0], SnapshotStream.Size);
  finally
    SnapShotStream.Free;
  end;

end;

procedure WriteSnapshot(const Writer: TStreamWriter; const Products: TList<TProductStatus>);
begin
  Writer.WriteLine('# This file was generated by TMS SmartSetup.');
  Writer.WriteLine('# use tms restore to restore the products and versions in this file.');
  Writer.WriteLine;
  //Products are already sorted. If not we would have to sort them here so the file is always the same.
  Writer.WriteLine('products:');

  for var Product in Products do
  begin
    Writer.WriteLine('  - ' + BBYamlEscapeString(Product.Id, false) + ':');
    Writer.WriteLine('      version: ' + BBYamlEscapeString(Product.InstalledVersion, false));
    Writer.WriteLine('      version type: ' + BBYamlEscapeString(Product.InstalledVersion.VersionTypeId, false));
    Writer.WriteLine('      server: ' + BBYamlEscapeString(Product.Server, false));
    if Product.Project <> nil then Writer.WriteLine('      url: ' + BBYamlEscapeString(Product.Project.Application.Url, false)); // For audit purposes
    Writer.WriteLine('      pinned: ' + BoolToStr(Product.Pinned, true).ToLowerInvariant);
    Writer.WriteLine;
  end;
end;

end.
